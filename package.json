{
  "name": "musicsensor",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:https": "vite --mode local-https --host 0.0.0.0",
